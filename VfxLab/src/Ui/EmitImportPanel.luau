-- VfxLab EmitImportPanel (Vide): BetterVfx EmitModuleImporter parity.
-- License prompt; on agree, installs the VfxLab runtime loader module
-- into ReplicatedStorage so games can drive effects at runtime.
local Vide = require(script.Parent.Parent.Modules.vide)
local create = Vide.create
local mount = Vide.mount
local Theme = require(script.Parent.Theme)
local Kit = require(script.Parent.Kit)

local LICENSE = [[VfxLab Runtime License (VRL) Version 1.0

Permission is granted to use the VfxLab runtime loader in your games,
free of charge, for any purpose. The loader is a thin accessor over
the VfxLab studio API and carries no warranty.

By clicking "I agree", a ModuleScript named "VfxLabRuntime" is placed
in ReplicatedStorage. Require it from your game scripts to emit and
control VfxLab effects at runtime.]]

local LOADER_SOURCE = [[-- VfxLabRuntime: accessor for the VfxLab studio/runtime API.
-- Generated by the VfxLab plugin. Do not edit by hand.
local VfxLabRuntime = {}
function VfxLabRuntime.Get()
	return shared.vfxlab
end
return VfxLabRuntime
]]

local EmitImportPanel = {}

function EmitImportPanel.Open(parentGui)
	local prompt = Kit.Prompt(parentGui, {
		Title = "Install runtime module",
		Size = UDim2.fromOffset(400, 0),
	})
	local box = create "TextBox" {
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Surface(),
		BorderSizePixel = 0,
		FontFace = Theme.Font,
		Size = UDim2.new(1, 0, 0, 0),
		Text = LICENSE,
		TextColor3 = Theme.Text(),
		TextEditable = false,
		TextSize = Theme.TextSizes.Base,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = prompt.Frame,
		create "UICorner" { CornerRadius = UDim.new(0, Theme.Rounding.Base) },
		create "UIPadding" {
			PaddingLeft = UDim.new(0, Theme.Padding.Side),
			PaddingRight = UDim.new(0, Theme.Padding.Side),
			PaddingTop = UDim.new(0, Theme.Padding.Side),
			PaddingBottom = UDim.new(0, Theme.Padding.Side),
		},
	}
	Kit.Button(prompt.Frame, {
		Text = "I agree to these Terms and Conditions",
		TextSize = Theme.TextSizes.Mini,
		Size = UDim2.new(1, 0, 0, 30),
		Primary = true,
		OnClick = function()
			local history = game:GetService("ChangeHistoryService")
			history:SetWaypoint("VfxLab Install Runtime - Before")
			local rs = game:GetService("ReplicatedStorage")
			local old = rs:FindFirstChild("VfxLabRuntime")
			if old then old:Destroy() end
			local mod = Instance.new("ModuleScript")
			mod.Name = "VfxLabRuntime"
			mod.Source = LOADER_SOURCE
			mod.Parent = rs
			game:GetService("Selection"):Set({ mod })
			history:SetWaypoint("VfxLab Install Runtime")
			prompt.Close()
			Kit.Notify(parentGui, "VfxLabRuntime installed")
		end,
	})
	return prompt
end

return EmitImportPanel
